# OneOfOne environment variables.
# Copy to .env.local for local dev, and set these in your Vercel project for prod.
# Leave the Supabase vars UNSET to run locally against the in-memory + disk mock.

# ── Supabase (Postgres + Auth + Storage) ────────────────────────────────────
# From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Secrets (use long random values in production) ──────────────────────────
# Signs cookies / local signed URLs.
ONEOFONE_SIGNING_SECRET=
# Verifies payment webhooks (must match the value your gateway signs with).
ONEOFONE_PAYMENT_WEBHOOK_SECRET=
# Admin password for /admin/login (owner@oneofone.co.za). 8+ characters.
# In production, admin login is refused until this AND ONEOFONE_SIGNING_SECRET
# (16+ characters) are set.
ONEOFONE_ADMIN_PASSWORD=
# One-time token to authorize POST /api/setup (inventory seed).
ONEOFONE_SETUP_TOKEN=

# ── Bank transfer (EFT / PayShap) — no gateway or registered business needed ──
# Customers see these on their order page + email and pay with the order
# reference (e.g. PAY1042). You confirm each one in /admin once the money is in
# your banking app. Set the bank fields and/or a PayShap ShapID.
# Optional fallback only: the owner normally enters these in /admin → Payment
# details (stored in the database), which overrides everything below.
ONEOFONE_EFT_BANK=
ONEOFONE_EFT_ACCOUNT_HOLDER=
ONEOFONE_EFT_ACCOUNT_NUMBER=
ONEOFONE_EFT_BRANCH_CODE=
ONEOFONE_EFT_ACCOUNT_TYPE=
ONEOFONE_PAYSHAP_ID=
# Days an unpaid bank-transfer order is held (shown to customers). Default 3.
ONEOFONE_EFT_HOLD_DAYS=

# ── Paystack payments (recommended; takes priority over Yoco) ───────────────
# From Paystack → Settings → API Keys & Webhooks. Start with sk_test_..., then
# switch to sk_live_... once your business is activated. Paystack also signs
# webhooks with this key, so no separate webhook secret is needed.
# Set the Webhook URL there to https://YOUR-DOMAIN/api/payments/webhook
PAYSTACK_SECRET_KEY=

# ── Yoco payments (alternative; used only if Paystack isn't set) ────────────
# From the Yoco dashboard → Developers. Use test keys first (sk_test_...).
YOCO_SECRET_KEY=
# The signing secret (whsec_...) Yoco gives you when you register the webhook
# pointing at https://YOUR-DOMAIN/api/payments/webhook
YOCO_WEBHOOK_SECRET=
# Absolute site URL for payment return links, e.g. https://oneofone-tawny.vercel.app
# (On Vercel this can be left blank — it falls back to the production domain.)
NEXT_PUBLIC_SITE_URL=

# ── Customer email — leave all unset to only log notifications ──────────────
# Option A (no domain needed): send from a Gmail address over SMTP.
#   1. Turn on 2-Step Verification on that Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Set the two values below (spaces in the app password are fine).
# Gmail allows roughly 500 emails/day. Other SMTP providers work too — set
# ONEOFONE_SMTP_HOST / ONEOFONE_SMTP_PORT (465 = TLS, 587 = STARTTLS).
ONEOFONE_SMTP_USER=
ONEOFONE_SMTP_PASSWORD=
ONEOFONE_SMTP_HOST=
ONEOFONE_SMTP_PORT=
# Option B: Resend (resend.com → API Keys). Needs your own verified domain;
# takes priority over SMTP when set.
RESEND_API_KEY=
# Sender. Required for Resend (on its verified domain). For SMTP it's optional
# and defaults to "OneOfOne <ONEOFONE_SMTP_USER>".
ONEOFONE_EMAIL_FROM=
# Where customer replies go (optional; defaults to the sender).
ONEOFONE_EMAIL_REPLY_TO=

# ── Safety ──────────────────────────────────────────────────────────────────
# The mock gateway is DISABLED in production (it marks orders paid without
# taking money). Only set this to "true" on a private staging deployment.
ONEOFONE_ALLOW_MOCK_PAYMENTS=

# ── Optional ────────────────────────────────────────────────────────────────
# WhatsApp support number, digits incl. country code (e.g. 27821234567).
NEXT_PUBLIC_SUPPORT_WHATSAPP=
